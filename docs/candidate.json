  "cards": [
    { "dot": "cyan", "title": "Onboarding & Auth", "items": [
      "Signup assigns each user a unique agentCode",
      "The JWT is issued as an httpOnly cookie, not stored in JS",
      "The local agent connects outbound to the server over Socket.IO"
    ] },
    { "dot": "orange", "title": "Async Telemetry", "items": [
      "Scans are triggered over REST, then pushed to the agent as socket events",
      "The agent runs local pip / npm commands and reports back",
      "The server persists telemetry, then emits scan_complete to refresh the dashboard"
    ] },
    { "dot": "violet", "title": "Fire-and-Forget Updates", "items": [
      "Upgrade requests emit an update_python / update_node socket command",
      "The agent runs pip install --upgrade or npm install -g",
      "The UI re-polls telemetry to reflect the new state"
    ] }
