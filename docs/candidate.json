  "cards": [
    {
      "dot": "cyan",
      "title": "Cryptographic Device Linking & Auth",
      "items": [
        "Signup assigns each user a unique agentCode; passwords hashed via bcrypt.",
        "CLI workstation calls POST /agent/link to enroll with hostname/platform metadata.",
        "Server generates a cryptographically secure 32-byte device token stored in user.agentTokens.",
        "JWT session token is issued as an HttpOnly, Secure, SameSite cookie."
      ]
    },
    {
      "dot": "emerald",
      "title": "Real-Time Room Routing & Presence",
      "items": [
        "Socket.IO separates agents into agent:${code} and dashboards into user:${code} rooms.",
        "On socket connection, server checks room membership and broadcasts agent_status (online/offline).",
        "Targeted room emission ensures zero cross-tenant event leakage between developer accounts."
      ]
    },
    {
      "dot": "orange",
      "title": "Multi-Ecosystem Telemetry Scans",
      "items": [
        "Scans triggered via REST or dashboard buttons are pushed to workstation via socket events.",
        "Agent runs isolated CLI audits: pip list --outdated --format=json, npm outdated -g, and Ollama models.",
        "Telemetry payload is persisted to MongoDB, followed by a scan_complete event to auto-refresh the UI."
      ]
    },
    {
      "dot": "violet",
      "title": "Live Streaming Updates & Privacy",
      "items": [
        "Upgrade actions dispatch package_update with language and package coordinates.",
        "Agent streams real-time stdout logs and progress stages (downloading, installing, verifying).",
        "Zero Source Code Access: Only package metadata and port telemetry are read—source files and secrets never leave your workstation."
      ]
    }
  ]
